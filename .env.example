# ResQ-Agent Environment Variables
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
S3_BUCKET=resq-agent-data-lake

# Bedrock
BEDROCK_KB_ID=YOUR_KNOWLEDGE_BASE_ID

# API Keys
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
NOAA_API_TOKEN=your_noaa_api_token_here

# DynamoDB Tables
DYNAMODB_EVENTS_TABLE=disaster-events
DYNAMODB_RESULTS_TABLE=assessment-results

# SNS
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:resq-agent-alerts-production

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_PASSWORD=change_me_in_production

# Logging
LOG_LEVEL=INFO
CLOUDWATCH_LOG_GROUP=/aws/lambda/resq

# Development Settings
ENVIRONMENT=development
DEBUG=false
